# Copy to functions/.env.babysteps-cbert for deployment. That file is ignored.
ALEXA_SKILL_ID=amzn1.ask.skill.replace-with-real-skill-id

# ALEXA_OAUTH_CLIENT_SECRET is stored with Firebase Secret Manager, not here.
PLAY_PACKAGE_NAME=com.cbcreations.babysteps
PLAY_SUBSCRIPTION_PRODUCT_IDS=babysteps_premium

# The existing unreleased test account is covered automatically by this cutoff.
LEGACY_SIGNUP_CUTOFF_ISO=2026-07-30T23:59:59+10:00

# Optional: add specific permanent legacy accounts, comma-separated.
LEGACY_ACCOUNT_EMAILS=

# AI stays disabled until the OpenAI project, spend limit, privacy copy and
# Firebase App Check registration are ready for the closed-test build.
AI_ENABLED=false
OPENAI_ASSISTANT_MODEL=gpt-5.6-terra
OPENAI_SUMMARY_MODEL=gpt-5.6-terra
AI_MONTHLY_BUDGET_USD=25
AI_INPUT_USD_PER_MTOK=2
AI_OUTPUT_USD_PER_MTOK=12

# OPENAI_API_KEY is stored in Firebase Secret Manager, never in this file.
