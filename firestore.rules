rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAuthorizedCaregiver(babyId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/babies/$(babyId)).data.authorizedCaregivers;
    }

    function validSleepPlace(place) {
      return place is map && place.keys().hasOnly(['id', 'label'])
        && place.id is string && place.id.matches('custom:[a-z0-9]+(-[a-z0-9]+)*')
        && place.id.size() <= 64
        && place.label is string && place.label.size() > 0 && place.label.size() <= 24;
    }

    function validSleepPlaces(places) {
      return places is list && places.size() <= 5
        && (places.size() < 1 || validSleepPlace(places[0]))
        && (places.size() < 2 || validSleepPlace(places[1]))
        && (places.size() < 3 || validSleepPlace(places[2]))
        && (places.size() < 4 || validSleepPlace(places[3]))
        && (places.size() < 5 || validSleepPlace(places[4]));
    }

    match /users/{userId} {
      allow create: if ownsUser(userId)
        && request.resource.data.keys().hasOnly([
          'displayName',
          'email',
          'babyIds',
          'activeBabyId',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.babyIds == []
        && request.resource.data.activeBabyId == null;

      allow read: if ownsUser(userId);

      allow update: if ownsUser(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'babyIds', 'activeBabyId', 'homeActions', 'quickCarePreferences', 'customSleepLocations', 'updatedAt'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['customSleepLocations'])
          || validSleepPlaces(request.resource.data.customSleepLocations));

      allow delete: if ownsUser(userId);
    }

    match /entitlements/{userId} {
      allow read: if ownsUser(userId);
      allow create, update, delete: if false;
    }

    match /playPurchases/{purchaseId} {
      allow read, write: if false;
    }

    match /playRtdnEvents/{eventId} {
      allow read, write: if false;
    }

    // AI consent, quotas, idempotency caches and operational totals are
    // server-owned. The Android app can reach them only through authenticated,
    // App Check-enforced callable functions.
    match /aiConsents/{userId} {
      allow read, write: if false;
    }

    match /aiUsage/{userId} {
      allow read, write: if false;
    }

    match /aiRequests/{requestId} {
      allow read, write: if false;
    }

    match /aiSummaryCache/{cacheId} {
      allow read, write: if false;
    }

    match /aiOperations/{operationId} {
      allow read, write: if false;
    }

    // Invite codes are created, accepted and revoked only through the
    // sharing_* callable functions.
    match /babyInvites/{code} {
      allow read, write: if false;
    }

    match /babies/{babyId} {
      allow create: if signedIn()
        && request.resource.data.authorizedCaregivers == [request.auth.uid];

      allow read: if signedIn()
        && request.auth.uid in resource.data.authorizedCaregivers;

      allow update: if signedIn()
        && request.auth.uid in resource.data.authorizedCaregivers
        && (
          request.resource.data.authorizedCaregivers == resource.data.authorizedCaregivers
          || (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['authorizedCaregivers', 'updatedAt'])
            && request.resource.data.authorizedCaregivers
              == resource.data.authorizedCaregivers.removeAll([request.auth.uid])
          )
        );

      allow delete: if signedIn()
        && resource.data.authorizedCaregivers == [request.auth.uid];

      // Who else can see this baby. Written by the sharing functions; a
      // caregiver may remove only their own entry (account deletion).
      match /caregivers/{caregiverId} {
        allow read: if isAuthorizedCaregiver(babyId);
        allow create, update: if false;
        allow delete: if ownsUser(caregiverId);
      }

      match /events/{eventId} {
        allow read: if isAuthorizedCaregiver(babyId);

        allow create: if isAuthorizedCaregiver(babyId)
          && request.resource.data.loggedBy == request.auth.uid
          && request.resource.data.type in [
            'feed', 'sleep', 'diaper', 'pumping', 'solids', 'growth',
            'potty', 'temperature', 'medication', 'tummyTime', 'bath',
            'milestone', 'symptom', 'appointment', 'immunization', 'teething'
          ]
          && request.resource.data.source == 'app'
          && request.resource.data.deletedAt == null;

        allow update: if isAuthorizedCaregiver(babyId)
          && request.resource.data.loggedBy == resource.data.loggedBy
          && request.resource.data.type == resource.data.type
          && request.resource.data.source == resource.data.source
          && request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if isAuthorizedCaregiver(babyId)
          && get(/databases/$(database)/documents/babies/$(babyId))
            .data.authorizedCaregivers == [request.auth.uid];
      }
    }
  }
}
