{
  "name": "babysteps",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-android.ps1",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "test": "vitest run tests/unit",
    "test:rules": "vitest run tests/firestore.rules.test.ts --maxWorkers=1",
    "test:emulators": "firebase emulators:exec --project babysteps-cbert --only firestore \"npm run test:rules\"",
    "verify:live-firebase": "node scripts/verify-live-firebase.mjs",
    "verify:monetization": "node scripts/verify-monetization-config.mjs",
    "verify:monetization:production": "node scripts/verify-monetization-config.mjs --production",
    "create:play-review-account": "node scripts/create-play-review-account.mjs",
    "eas-build-pre-install": "node scripts/verify-monetization-config.mjs",
    "prebuild:android": "expo prebuild --platform android --clean",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production",
    "build:watch:debug": "android\\gradlew.bat -p wear-app :app:assembleDebug"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-firebase/app": "^25.1.0",
    "@react-native-firebase/app-check": "^25.1.0",
    "@react-native-firebase/auth": "^25.1.0",
    "@react-native-firebase/firestore": "^25.1.0",
    "@react-native-firebase/functions": "^25.1.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.37",
    "expo-application": "~7.0.8",
    "expo-calendar": "~15.0.8",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-iap": "^4.7.2",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-speech-recognition": "^3.1.3",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-mobile-ads": "16.3.3",
    "react-native-paper": "^5.12.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/react": "~19.1.10",
    "firebase": "^12.15.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10"
  },
  "private": true
}
