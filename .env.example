# Public build-time identifiers. These are identifiers, not secrets.
# Development builds safely fall back to Google test ads.
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-0000000000000000~0000000000
EXPO_PUBLIC_ADMOB_BANNER_ID=ca-app-pub-0000000000000000/0000000000
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=ca-app-pub-0000000000000000/0000000000
EXPO_PUBLIC_PLAY_PREMIUM_PRODUCT_ID=babysteps_premium
# Leave false for ordinary local development. Enable only when deliberately
# testing a build/account that Google Play recognises for billing.
EXPO_PUBLIC_ENABLE_PLAY_BILLING_IN_DEV=false

# Optional for an installed development client. Register this ignored value in
# Firebase App Check before exercising the enforced AI callable functions.
EXPO_PUBLIC_FIREBASE_APP_CHECK_DEBUG_TOKEN=
