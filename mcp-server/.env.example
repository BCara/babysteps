# Exact public origin, without /mcp. HTTP loopback is only for local development.
MCP_PUBLIC_URL=http://127.0.0.1:8787
PORT=8787
GOOGLE_CLOUD_PROJECT=babysteps-cbert
FIREBASE_WEB_CONFIG={"apiKey":"your-public-Firebase-web-api-key","authDomain":"babysteps-cbert.firebaseapp.com","projectId":"babysteps-cbert"}
# Use Application Default Credentials on the server. Never put service-account keys in a plugin.
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/path/service-account.json
MCP_ALLOW_LOCAL_REDIRECTS=false
# Set to the actual trusted reverse-proxy hop count when deployed.
MCP_TRUST_PROXY_HOPS=0
