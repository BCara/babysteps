{
  "expo": {
    "name": "PitterPatter",
    "slug": "babysteps",
    "owner": "cbert89",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "babysteps",
    "newArchEnabled": true,
    "backgroundColor": "#FFF9F5",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.babysteps.app"
    },
    "android": {
      "package": "com.cbcreations.babysteps",
      "versionCode": 3,
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF9F5"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "./plugins/withQuickCareWidget",
      "./plugins/withWearBridge",
      "@react-native-firebase/app",
      "@react-native-firebase/app-check",
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PitterPatter to choose an appointment or immunisation image for optional field extraction.",
          "cameraPermission": "Allow PitterPatter to photograph an appointment or immunisation record for optional field extraction."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow PitterPatter to use the microphone so you can log feeds, sleeps, and nappies by voice.",
          "speechRecognitionPermission": "Allow PitterPatter to recognise your speech so voice entries can be turned into care logs."
        }
      ],
      "expo-calendar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFF9F5",
          "dark": {
            "backgroundColor": "#15131F"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "da4692ab-5a18-4a3c-8c1c-e0e6dff752c7"
      }
    }
  }
}
