{
  "expo": {
    "name": "BabySteps",
    "slug": "babysteps",
    "owner": "cbert89",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "babysteps",
    "newArchEnabled": true,
    "backgroundColor": "#FFF9F5",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.babysteps.app"
    },
    "android": {
      "package": "com.babysteps.app",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF9F5"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFF9F5",
          "dark": {
            "backgroundColor": "#15131F"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "da4692ab-5a18-4a3c-8c1c-e0e6dff752c7"
      }
    }
  }
}
